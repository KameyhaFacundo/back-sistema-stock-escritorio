APP_NAME="Stockana"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_prueba
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Recibe un aviso por mail cada vez que se registra una empresa nueva
ADMIN_NOTIFY_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

COMPANY_NAME="Your Company Name"
COMPANY_ADDRESS="Your Address"
COMPANY_POSTAL_CODE="00000"
COMPANY_CITY="Your City"
COMPANY_PHONE="+00 (00) 0000-0000"
COMPANY_FAX=""
COMPANY_IDENT="00-00000000-0"
COMPANY_EMAIL="contact@yourcompany.com"
COMPANY_WEB="https://www.yourcompany.com"

PAYWAY_ENV='homo'
PAYWAY_API_TOKEN=''
PAYWAY_CUIT=''

MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# Clave secreta del webhook (dashboard de MP → Tus integraciones → Notificaciones
# webhook), NO es el access token. Sin esto seteado, la firma x-signature no se
# valida (ver VerifiesMercadoPagoWebhook) — cargarla antes de salir a producción.
MP_WEBHOOK_SECRET=

# OAuth Marketplace/Connect — cada empresa conecta su propia cuenta de MP para cobrar con Point
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_OAUTH_REDIRECT_URI=https://your-api.example.com/api/mercadopago/callback
JWT_SECRET=

# Cobrar con Point (lector de tarjeta) deshabilitado temporalmente — no afecta
# a QR. Poner en true para reactivarlo (ver PagoPointController::crearIntento).
POINT_HABILITADO=false

# Google Gemini — requerido para las funciones de IA (Plan IA): escaneo de
# facturas, sugerencia de categoría y de precio de venta. Sin esto configurado
# esas funciones responden con un error claro en vez de fallar en silencio.
GEMINI_API_KEY=

# Kill switch de la verificación en dos pasos (2FA) — ver config/features.php.
# En false: nadie puede activarla, y el login no la exige aunque algún usuario
# ya la tuviera configurada (queda guardada, no se borra).
TWO_FACTOR_ENABLED=true

# Facturación electrónica ARCA (ex AFIP) — cada empresa carga su propio
# certificado/clave/CUIT desde Configuración → Facturación (ver
# EmpresaController::actualizarArca y Empresa::arcaConfigurada). No hay nada
# que configurar acá a nivel sistema.

# Monitoreo de errores (sentry.io, plan gratis) — vacío = el SDK no manda nada,
# no rompe nada en local. Completar en producción con el DSN del proyecto.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Google OAuth — credenciales desde Google Cloud Console → APIs y Servicios →
# Credenciales → ID de cliente OAuth 2.0 (tipo "Aplicación web").
# GOOGLE_REDIRECT_URI debe coincidir exactamente con la URI de redireccionamiento
# autorizada en la consola de Google: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/api/auth/google/callback
