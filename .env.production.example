# Plantilla para la instalación de escritorio empaquetada por escritorio-launcher
# (no para desarrollo local — para eso usá .env.example). El launcher la copia
# a la carpeta de datos persistente (%APPDATA%) en el primer arranque y corre
# `artisan key:generate` / `artisan jwt:secret` para completar APP_KEY y
# JWT_SECRET, que acá quedan vacíos a propósito.

APP_NAME="Stockana"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# El launcher setea DB_DATABASE por variable de entorno (APP_STORAGE_PATH/
# APP_ENV_PATH, ver bootstrap/app.php) apuntando a la carpeta de datos
# persistente — no hace falta declararlo acá.

# database, no file: el driver de archivos usa flock() para leer cada
# entrada de forma segura entre procesos — con el servidor web y la cola
# (queue:work) corriendo como procesos PHP separados pero pegándole a los
# mismos archivos, un flock() esperando el lock del otro proceso puede
# colgarse, y a los 30s de max_execution_time mata TODO el servidor
# ("El servidor se detuvo", visto en vivo con "Maximum execution time of 30
# seconds exceeded" apuntando justo a ese flock() en Filesystem::sharedGet()).
CACHE_DRIVER=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

JWT_SECRET=

# Mercado Pago — opcional, para cobrar con QR/Point en la caja. Se completa
# después desde Configuración → Cobros si el comercio lo va a usar.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_OAUTH_REDIRECT_URI=${APP_URL}/api/mercadopago/callback
POINT_HABILITADO=false

# Google Gemini — opcional, para escaneo de facturas y sugerencias de la IA.
GEMINI_API_KEY=

TWO_FACTOR_ENABLED=true

# Facturación electrónica ARCA (ex AFIP) — el comercio carga su propio
# certificado/clave/CUIT desde Configuración → Facturación una vez instalado.
# No hay nada que configurar acá a nivel sistema.

# Monitoreo de errores (sentry.io) — opcional, vacío = desactivado.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Google OAuth — opcional, para "Iniciar sesión con Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/api/auth/google/callback
